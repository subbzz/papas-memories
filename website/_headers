/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; font-src 'self'; img-src 'self' data: https://*.sharepoint.com https://*.svc.ms; media-src 'self' https://*.sharepoint.com; connect-src 'self' https://graph.microsoft.com https://login.microsoftonline.com; frame-src https://login.microsoftonline.com https://challenges.cloudflare.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; manifest-src 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Robots-Tag: noindex, nofollow
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/api/*
  Cache-Control: no-store
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/family/*
  Cache-Control: no-cache
/admin/*
  Cache-Control: no-cache
/bye/*
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/music.js
  Cache-Control: no-cache
/admin.js
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/memories.js
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache
/brand/*
  Cache-Control: public, max-age=86400
  Cross-Origin-Resource-Policy: cross-origin
